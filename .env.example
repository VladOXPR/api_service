# OpenAI API Key for captcha solving
OPENAI_API_KEY=your_openai_api_key_here

# Energo Dashboard Credentials
ENERGO_USERNAME=your_energo_username
ENERGO_PASSWORD=your_energo_password

# Token extraction tuning (optional)
# TOKEN_CAPTURE_TIMEOUT_MS=30000
# CAPTCHA_MAX_ATTEMPTS=3
# LOGIN_MAX_ATTEMPTS=2
# TOKEN_HEALTH_PROBE_STATION_ID=your_station_id
# TOKEN_REFRESH_URL=https://api.cuub.tech/token
# TOKEN_REFRESH_INTERNAL_BASE_URL=http://127.0.0.1:8080
# TOKEN_HEALTH_CHECK_INTERVAL_MS=900000
# TOKEN_BACKUP_REFRESH_HOURS=24
# TOKEN_EXTRACT_DEBUG=0

# Puppeteer (Docker / Cloud Run)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Stripe (for /stripe/charges and /rents/*)
STRIPE_SECRET_KEY=sk_live_your_key_here

# Shared secret for /pos/* endpoints (POST /pos/start_rent, PATCH /pos/end_rent, GET /pos/rents).
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Without this set, every /pos/* request returns 503.
POS_API_TOKEN=replace_with_a_strong_random_value
